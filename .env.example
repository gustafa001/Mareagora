# MaréAgora — Variáveis de ambiente

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
# Protege /api/push/notify. Use o MESMO valor no Vercel e no secret CRON_SECRET do GitHub Actions
CRON_SECRET=
NOTIFY_SECRET=

# Inscrições de push (Supabase). Rode scripts/sql/push_subscriptions.sql antes.
# Só no servidor — nunca com prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AdSense — desativado por padrão; ativar apenas em páginas com >100 visitas/mês
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Revalidation (on-demand via API)
REVALIDATE_TOKEN=

# Google Search Console (service account JSON)
SERVICE_ACCOUNT_JSON=
