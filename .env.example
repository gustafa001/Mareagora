# MaréAgora — Variáveis de ambiente

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
NOTIFY_SECRET=

# AdSense — desativado por padrão; ativar apenas em páginas com >100 visitas/mês
NEXT_PUBLIC_ADSENSE_ENABLED=false

# Revalidation (on-demand via API)
REVALIDATE_TOKEN=

# Google Search Console (service account JSON)
SERVICE_ACCOUNT_JSON=
